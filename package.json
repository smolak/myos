{
  "name": "myos",
  "version": "0.0.1",
  "description": "Local-first productivity dashboard built with Electrobun",
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "test": "bun run test:ui && bun run test:core",
    "test:core": "bun test --pass-with-no-tests ./src/core/bun ./src/features/todo/bun ./src/features/pomodoro/bun ./src/features/rss-reader/bun ./src/features/daily-journal/bun ./src/features/calendar/bun ./src/features/calendar/shared ./src/features/clock/bun ./src/features/weather/bun ./src/features/habits/bun ./src/features/bookmarks/bun ./src/features/countdowns/bun ./src/features/snippets/bun",
    "test:ui": "vitest run",
    "test:watch": "bun test --watch --pass-with-no-tests ./src/core/bun ./src/features/todo/bun ./src/features/pomodoro/bun ./src/features/rss-reader/bun ./src/features/daily-journal/bun ./src/features/calendar/bun ./src/features/calendar/shared ./src/features/clock/bun ./src/features/weather/bun ./src/features/habits/bun ./src/features/bookmarks/bun ./src/features/countdowns/bun ./src/features/snippets/bun",
    "test:ui:watch": "vitest",
    "start": "vite build && electrobun dev",
    "dev": "electrobun dev --watch",
    "dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
    "hmr": "vite --config vite.config.ts",
    "build:dev": "bun install && electrobun build",
    "build:stable": "vite build && electrobun build --env=stable",
    "build:canary": "vite build && electrobun build --env=canary",
    "tsc": "tsc"
  },
  "dependencies": {
    "electrobun": "1.18.1",
    "nanoid": "^5.1.16",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-grid-layout": "^2.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "concurrently": "^10.0.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
